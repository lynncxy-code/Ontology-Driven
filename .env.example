# 每台电脑单独复制为 .env；.env 已被 Git 忽略。
# 按本机 UE 项目的 Models 目录调整。
MODELS_HOST_DIR=D:/path/to/your/Models

ARTSTUDIO_BASE_URL=https://artstudio.digioasis.tech/api
ARTSTUDIO_TIMEOUT=5
# 一般保持为空，用户在“我的资产”中直接连接 ArtStudio 账号。
# 仅供无人值守部署或管理员调试回退；不要提交真实 Token。
ARTSTUDIO_TOKEN=

# 仅供纯演示环境；开启后会周期性改变 AGV 等示例实例的位置。
ONTOTWIN_MOCK_SIMULATOR_ENABLED=false

# 4.0.3 漫游点位语音。试用/开发可填写长期 AK；生产建议使用临时 Token。
ONTOTWIN_TTS_PROVIDER=alibaba
ONTOTWIN_TTS_ALIBABA_APPKEY=
ONTOTWIN_TTS_ALIBABA_REGION=cn-shanghai
ONTOTWIN_TTS_ALIBABA_TOKEN=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
