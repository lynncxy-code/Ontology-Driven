{
  "services": {
    "db": {
      "image": "",
      "environment": {"POSTGRES_USER": "ontotwin", "POSTGRES_PASSWORD": "", "POSTGRES_DB": "ontotwin"},
      "volumes": ["db:/var/lib/postgresql/data"],
      "healthcheck": {"test": ["CMD-SHELL", "pg_isready -U ontotwin -d ontotwin"], "interval": "3s", "timeout": "3s", "retries": 30}
    },
    "neo4j": {
      "image": "",
      "environment": {"NEO4J_AUTH": "", "NEO4J_server_memory_heap_initial__size": "256m", "NEO4J_server_memory_heap_max__size": "512m"},
      "volumes": ["graph:/data"]
    },
    "backend": {
      "image": "",
      "ports": [],
      "depends_on": {"db": {"condition": "service_healthy"}},
      "environment": {"ONTOTWIN_STORE": "pg", "ONTOTWIN_RELEASE_ID": "", "ONTOTWIN_MOCK_SIMULATOR_ENABLED": "false", "DATABASE_URL": "", "NEO4J_URI": "bolt://neo4j:7687", "NEO4J_PASSWORD": "", "MODELS_DIR": "/models"},
      "volumes": ["data:/app/data", "models:/models"]
    }
  },
  "volumes": {}
}
