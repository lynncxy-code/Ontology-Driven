FROM python:3.10-slim

WORKDIR /app

COPY 01-source/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# RC images contain both the backend and the exact frontend snapshot.  The
# runtime therefore does not depend on a host checkout or source mounts.
COPY 01-source/backend/ /app/
COPY 01-source/frontend/ /frontend/

ENV PYTHONUNBUFFERED=1
EXPOSE 5000
CMD ["python", "app.py"]
