# Docker-specific ignore file kept at the build-context root because the
# release command builds with: docker build -f 02-releases/windows-all-in-one/Dockerfile.backend .
*
!01-source/
!01-source/backend/
!01-source/backend/**
!01-source/frontend/
!01-source/frontend/**
!02-releases/
!02-releases/windows-all-in-one/
!02-releases/windows-all-in-one/requirements.release.txt
!02-releases/training-platform/
!02-releases/training-platform/check_frontend.py
!wheels/
!wheels/**
01-source/backend/data/
01-source/backend/**/__pycache__/
01-source/frontend/**/*.bak*
