FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY deploy/windows-all-in-one/requirements.release.txt /tmp/requirements.release.txt
RUN pip install --no-cache-dir -r /tmp/requirements.release.txt

COPY backend/ /app/
COPY frontend/ /frontend/
COPY assets/ /assets/

# Development backups and host-specific state must never be baked into the image.
RUN rm -rf /app/data/backups /app/data/projects /app/data/project_assets \
    && mkdir -p /app/data/project_assets /exports

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "8", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
