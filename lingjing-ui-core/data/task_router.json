    {
      "id": "b_system_advanced_list",
      "scene": "b_system",
      "page_types": ["advanced_list"],
      "target_type": "advanced_list",
      "keywords_zh": ["高级筛选列表", "侧边筛选", "高级筛选面板", "左侧筛选", "多维筛选"],
